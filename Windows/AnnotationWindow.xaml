<Window x:Class="SampleViewer.Windows.AnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="メモ" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="メモを付ける対象" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
        <RadioButton x:Name="RB_Image" GroupName="Target" Margin="0,2"/>
        <RadioButton x:Name="RB_Measurement" GroupName="Target" Margin="0,2"/>
        <RadioButton x:Name="RB_Durability" GroupName="Target" Margin="0,2"/>

        <TextBlock Text="カテゴリ" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4"/>
        <ComboBox x:Name="CB_Category" Width="180" HorizontalAlignment="Left"/>

        <TextBlock Text="コメント" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4"/>
        <TextBox x:Name="TB_Comment" Height="110" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" Padding="6,4" VerticalScrollBarVisibility="Auto"/>

        <TextBlock x:Name="TB_Error" Foreground="OrangeRed" Margin="0,6,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="キャンセル" Width="96" Height="32" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="保存" Width="96" Height="32" Style="{StaticResource PrimaryButton}" IsDefault="False" Click="Save_Click"/>
        </StackPanel>
        <TextBlock Text="Ctrl+Enter で保存" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/>
    </StackPanel>
</Window>
