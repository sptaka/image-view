<Window x:Class="SampleViewer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        xmlns:local="clr-namespace:SampleViewer"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="SampleViewer" Height="900" Width="1600" ContentRendered="Window_ContentRendered"
        MinWidth="1200" MinHeight="700" WindowState="Normal"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="12"
        Background="#F3F5F9"
        KeyDown="Window_KeyDown" PreviewKeyDown="Window_PreviewKeyDown" Closed="MainWindow_Closed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Modern.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <GridLength x:Key="PaneWidth">260</GridLength>
            <GridLength x:Key="RightPaneWidth">420</GridLength>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <!-- 画像（アイコン）の表示サイズ。スライダー／自動調整で書き換える -->
            <sys:Double x:Key="IconSize">150</sys:Double>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" FontSize="12" Background="White" Padding="4,2" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1">
            <MenuItem Header="開発者" x:Name="MenuDeveloper">
                <MenuItem Header="Developer Mode" x:Name="MenuDeveloperMode" Click="DeveloperMode_click" />
            </MenuItem>
            <MenuItem Header="表示">
                <MenuItem Header="検索ウィンドウ" x:Name="IsOpenLeftPane" IsCheckable="True" IsChecked="false" Click="ChangePane_Click" />
                <MenuItem Header="グラフ・比較リストウィンドウ" x:Name="IsOpenRightPane" IsCheckable="True" IsChecked="false" Click="ChangePane_Click" />
            </MenuItem>
            <MenuItem Header="設定">
                <MenuItem x:Name="MenuImageSize" Header="表示データサイズ">
                    <MenuItem Header="中（1000×1000 jpg圧縮 :高速）" Tag="jpg"  x:Name="MenuLargeImage" Click="MenuImageSize_Click" />
                    <MenuItem Header="オリジナル（2400×3000 非圧縮png [300dpi時]：低速)" Tag="png" x:Name="MenuOOriginalImage" Click="MenuImageSize_Click" />
                </MenuItem>
                <MenuItem x:Name="MenuDownloadMode" Header="ダウンロード方式">
                    <MenuItem Header="Box (要Box drive)" x:Name="MenuBoxMode" Tag="Box" IsCheckable="True" Click = "MenuDownloadMode_click" />
                    <MenuItem Header="クエリ (BIL2030493でQuerySyncer起動が必要)" x:Name="MenuQueryMode" Tag="Query" IsCheckable="True" Click="MenuDownloadMode_click" />
                    <MenuItem Header="ローカルデータ (BIL2030493でのみ利用可）" x:Name="MenuLocalMode" Tag="Local" IsCheckable="True" Click = "MenuDownloadMode_click" />
                </MenuItem>
                <MenuItem x:Name="MenuSearchLimit" Header="検索一覧の表示件数上限">
                    <MenuItem Header="1000" Tag="1000" x:Name="MenuLimit1000" IsCheckable="True" Click="MenuSearchLimit_Click" />
                    <MenuItem Header="10000" Tag="10000" x:Name="MenuLimit10000" IsCheckable="True" Click="MenuSearchLimit_Click" />
                    <MenuItem Header="100000" Tag="100000" x:Name="MenuLimit100000" IsCheckable="True" Click="MenuSearchLimit_Click" />
                    <MenuItem Header="上限無し" Tag="999999999" x:Name="MenuLimitUnlimited" IsCheckable="True" Click="MenuSearchLimit_Click" />
                </MenuItem>
                <Separator/>
                <MenuItem Header="設定を初期化" Click="InitializeParameter_Click" />
            </MenuItem>
            <MenuItem Header="ツール">
                <MenuItem Header="アイコンデータの管理" Click="ManageIcons_Click" />
                <MenuItem Header="BOX driveをインストール" Click="InstallBoxDrive_Click" />
                <MenuItem Header="通信状態表示" Click="ShowNetworkStatus_Click"/>
                <MenuItem Header="通信状態更新" Click="RefreshNetworkStatus_Click"/>
                <MenuItem Header="DB BrowserでローカルDBを開く" Foreground="Gray" Click="OpenLocalDBbyDbBrowser" />
                <MenuItem Header="DB BrowserでサーバーDBを開く" Foreground="Gray" Click="OpenSvrDBbyDbBrowser" />
                <MenuItem Header="DB Browserでサーバーアイコンカタログを開く" Foreground="Gray" Click="OpenSvrIconCatalogbyDbBrowser" />
            </MenuItem>
            <MenuItem Header="管理">
                <MenuItem Header="ローカルフォルダを開く" Click="OpenLocalFolder_Click" />
                <MenuItem Header="クエリフォルダを開く" Click="OpenQueryFolder_Click" />
                <MenuItem Header="レスポンスフォルダを開く" Click="OpenResponseFolder_Click" />
                <MenuItem Header="DB管理ツール" Foreground="Gray" />
            </MenuItem>
            <MenuItem Header="ヘルプ">
                <MenuItem Header="ヘルプの表示" Click="ShowHelpWindow"/>
                <MenuItem Header="バージョン情報" Click="ShowVersionInfo_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="6,2">
            <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource TextSecondaryBrush}"/>
            <ProgressBar x:Name="DownloadProgress" Width="150" Height="6" Margin="10,0,0,0" Minimum="0" Maximum="100"
                         Foreground="{StaticResource BrandBrush}" Background="{StaticResource BrandLightBrush}" BorderThickness="0"/>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="{StaticResource PaneWidth}" />
                <ColumnDefinition x:Name="CenterCol" Width="*"/>
                <ColumnDefinition x:Name="RightCol" Width="{StaticResource RightPaneWidth}" />
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="0" HorizontalAlignment="Right" Style="{StaticResource PaneSplitter}"/>
            <GridSplitter Grid.Column="2" HorizontalAlignment="Left" Style="{StaticResource PaneSplitter}"/>

            <!-- ===== 左：検索ペイン（ブルー基調） ===== -->
            <Border Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0D2EA0" Offset="0"/>
                        <GradientStop Color="#0A2585" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- タイトル。右端は境界線と重なるため閉じるボタンを内側に置く -->
                    <DockPanel Grid.Row="0" Margin="16,14,10,6">
                        <Button DockPanel.Dock="Right" Content="◀" Style="{StaticResource PaneIconButton}" VerticalAlignment="Top"
                                Click="ChangeLeftPane_Click" ToolTip="検索ペインを閉じる"/>
                        <StackPanel IsHitTestVisible="False">
                            <TextBlock Text="SampleViewer" FontFamily="Segoe UI" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="耐久印字サンプル ビューワー" Foreground="{StaticResource PaneTextSubBrush}" FontSize="11" Margin="1,1,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12,8,12,12">

                            <!-- ID検索 -->
                            <Border Style="{StaticResource PaneCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="ID・シリアル検索" Style="{StaticResource PaneSectionTitle}"/>
                                    <TextBlock Text="耐久ID・評価目的で絞り込み（Enterで選択）" Style="{StaticResource PaneFieldLabel}"/>
                                    <TextBox x:Name="TB_TaikyuCode" Height="28" Margin="0,0,0,8" KeyDown="TB_TaikyuCode_KeyDown" TextChanged="TB_TaikyuCode_TextChanged"/>
                                    <TextBlock Text="シリアル番号で絞り込み（現像器・ドラム・本体）" Style="{StaticResource PaneFieldLabel}"/>
                                    <TextBox x:Name="TB_SerialNo" Height="28" KeyDown="TB_SerialNo_KeyDown" TextChanged="TB_SerialNo_TextChanged"
                                             ToolTip="現像器(TN1～4)・ドラム(DRM1～4)・本体のシリアル番号の一部で耐久を絞り込みます。&#10;ハイフン・空白・大文字小文字の違いは無視します"/>
                                </StackPanel>
                            </Border>

                            <!-- 条件検索 -->
                            <Border Style="{StaticResource PaneCardBorder}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="クリア" Style="{StaticResource PaneGhostButton}"
                                                Click="ConditionResetButton_Click" ToolTip="検索条件をすべて解除します（R キー）"/>
                                        <TextBlock Text="条件検索" Style="{StaticResource PaneSectionTitle}" Margin="0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="メーカー" Style="{StaticResource PaneFieldLabel}"/>
                                    <ComboBox x:Name="CB_maker" SelectionChanged="Condition_Changed" Margin="0,0,0,8"/>
                                    <TextBlock Text="機種" Style="{StaticResource PaneFieldLabel}"/>
                                    <ComboBox x:Name="CB_model" SelectionChanged="Condition_Changed" Margin="0,0,0,8"/>
                                    <TextBlock Text="環境" Style="{StaticResource PaneFieldLabel}"/>
                                    <ComboBox x:Name="CB_env" SelectionChanged="Condition_Changed"/>
                                </StackPanel>
                            </Border>

                            <!-- 耐久ID一覧 -->
                            <Border Style="{StaticResource PaneCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="耐久ID" Style="{StaticResource PaneSectionTitle}"/>
                                    <TextBlock x:Name="ResultCount" Foreground="White" FontSize="11" Margin="2,0,0,6"/>
                                    <Border Background="White" CornerRadius="8" Padding="2">
                                        <ListBox x:Name="LB_taikyu_ID" SelectionMode="Extended" SelectionChanged="LB_taikyu_ID_Changed"
                                                 MouseDoubleClick="LB_taikyu_ID_MouseDoubleClick"
                                                 BorderThickness="0" MaxHeight="260"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,1">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding TaikyuId}" Width="42" FontSize="9" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding EvaluationPurpose}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="42,0,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    <TextBlock Text="ダブルクリックで耐久比較に追加（最大4件）" Foreground="{StaticResource PaneTextSubBrush}" FontSize="10" Margin="2,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 画像情報 -->
                            <Border Style="{StaticResource PaneCardBorder}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="画像情報" Style="{StaticResource PaneSectionTitle}"/>
                                    <Border Background="White" CornerRadius="8" Padding="2">
                                        <ListBox x:Name="LB_ImageInfo" Height="180" FontSize="11" BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== 中央：絞り込みバー＋画像表示領域 ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="8,8,8,0">
                    <Button x:Name="Button_OpenLeftPane" DockPanel.Dock="Left" Content="▶" Style="{StaticResource IconButton}"
                            VerticalAlignment="Center" Margin="0,0,6,0" Click="ChangeLeftPane_Click" ToolTip="検索ペインを開く"/>
                    <Button x:Name="Button_OpenRightPane" DockPanel.Dock="Right" Content="◀" Style="{StaticResource IconButton}"
                            VerticalAlignment="Center" Margin="6,0,0,0" Click="ChangeRightPane_Click" ToolTip="グラフ・比較リストを開く"/>

                    <!-- 絞り込み・表示項目 -->
                    <Border Style="{StaticResource CardBorder}" Padding="12,6">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,18,2"
                                        ToolTip="印字枚数の範囲で絞り込みます（例：50000、50k）。Enter で反映、空欄は制限なし">
                                <TextBlock Text="印字枚数" Style="{StaticResource ToolbarLabel}"/>
                                <TextBox x:Name="TB_PagesMin" Width="70" Height="26" KeyDown="PagesRange_KeyDown" LostFocus="PagesRange_LostFocus"/>
                                <TextBlock Text="～" Style="{StaticResource ToolbarLabel}" Margin="4,0"/>
                                <TextBox x:Name="TB_PagesMax" Width="70" Height="26" KeyDown="PagesRange_KeyDown" LostFocus="PagesRange_LostFocus"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                                <TextBlock Text="パターン" Style="{StaticResource ToolbarLabel}"/>
                                <ComboBox x:Name="CB_SamplePatternTop" Width="90" SelectionChanged="Condition_Changed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,24,2">
                                <TextBlock Text="色" Style="{StaticResource ToolbarLabel}"/>
                                <ComboBox x:Name="CB_colorTop" Width="90" SelectionChanged="Condition_Changed"/>
                            </StackPanel>
                            <Border Width="1" Background="{StaticResource BorderBrushLight}" Margin="0,4,24,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <TextBlock Text="表示項目" Style="{StaticResource ToolbarLabel}"/>
                                <ComboBox x:Name="CB_InfoLabel1" Width="110" Margin="0,0,6,0" DropDownClosed="InfoLabel_Changed"/>
                                <ComboBox x:Name="CB_InfoLabel2" Width="110" Margin="0,0,6,0" DropDownClosed="InfoLabel_Changed"/>
                                <ComboBox x:Name="CB_InfoLabel3" Width="110" DropDownClosed="InfoLabel_Changed"/>
                            </StackPanel>
                            <Border Width="1" Background="{StaticResource BorderBrushLight}" Margin="24,4,24,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <TextBlock Text="画像サイズ" Style="{StaticResource ToolbarLabel}"/>
                                <Slider x:Name="SL_IconSize" Width="120" Minimum="80" Maximum="150" Value="150" VerticalAlignment="Center"
                                        SmallChange="10" LargeChange="50" ValueChanged="IconSize_ValueChanged"/>
                                <TextBlock x:Name="TB_IconSize" Text="150" Width="30" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="6,0,8,0"/>
                                <CheckBox x:Name="CB_IconSizeAuto" Content="自動" VerticalAlignment="Center"
                                          Checked="IconSizeAuto_Changed" Unchecked="IconSizeAuto_Changed"
                                          ToolTip="耐久比較時、全ての行が縦に収まるサイズに自動調整します"/>
                            </StackPanel>
                            <Border Width="1" Background="{StaticResource BorderBrushLight}" Margin="24,4,24,4"/>
                            <CheckBox x:Name="CB_FirstImageOnly" Content="同枚数・同パターンは1枚のみ" VerticalAlignment="Center"
                                      Checked="FirstImageOnly_Changed" Unchecked="FirstImageOnly_Changed"
                                      ToolTip="同じ耐久・同じ枚数・同じパターンの画像が複数ある場合、最初の1枚だけを表示します"/>
                        </WrapPanel>
                    </Border>
                </DockPanel>

                <!-- 耐久比較：上部に表示モードのツールバー、その下に耐久ごとの行 -->
                <DockPanel x:Name="CompareArea" Grid.Row="1">
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="8,8,8,0" Padding="10,5">
                        <WrapPanel>
                            <TextBlock Text="表示モード" Style="{StaticResource ToolbarLabel}"/>
                            <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="7" Padding="2" Margin="0,0,20,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RB_CompareIndependent" Content="独立" GroupName="CompareMode" IsChecked="True"
                                                 Style="{StaticResource SegmentRadio}" Checked="CompareOption_Changed"
                                                 ToolTip="各行を個別にスクロールします"/>
                                    <RadioButton x:Name="RB_CompareSync" Content="シンクロ" GroupName="CompareMode"
                                                 Style="{StaticResource SegmentRadio}" Checked="CompareOption_Changed"
                                                 ToolTip="枚数を揃えて全行を一緒にスクロールします"/>
                                </StackPanel>
                            </Border>
                            <CheckBox x:Name="CB_CompareCommonOnly" Content="共通枚数のみ" VerticalAlignment="Center" Margin="0,0,20,0"
                                      Checked="CompareOption_Changed" Unchecked="CompareOption_Changed"
                                      ToolTip="全ての耐久に存在する枚数・パターンの画像だけを表示します"/>
                            <TextBlock Text="近似の許容差" Style="{StaticResource ToolbarLabel}"/>
                            <ComboBox x:Name="CB_CompareTolerance" Width="100" SelectedIndex="1" IsEnabled="False" VerticalAlignment="Center"
                                      SelectionChanged="CompareOption_Changed"
                                      ToolTip="シンクロ時、同じ枚数が無い行に表示する近似画像の許容差。超える場合は空欄">
                                <ComboBoxItem Content="±500枚" Tag="500"/>
                                <ComboBoxItem Content="±1000枚" Tag="1000"/>
                                <ComboBoxItem Content="±2000枚" Tag="2000"/>
                                <ComboBoxItem Content="±5000枚" Tag="5000"/>
                                <ComboBoxItem Content="制限なし" Tag=""/>
                            </ComboBox>
                            <Button Content="すべてクリア" Margin="20,0,0,0" Padding="10,3" VerticalAlignment="Center"
                                    Click="ClearAllCompareTargets_Click" ToolTip="比較中の耐久をすべて外します（Esc キー）"/>
                            <TextBlock Text="ホイール：左右　Shift＋ホイール：上下　←→ Home End：移動" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        </WrapPanel>
                    </Border>

                    <!-- 外側は縦スクロールのみ（横を無効にして内側の行へ有限の幅を渡す） -->
                    <ScrollViewer x:Name="SV_CompareRows" SizeChanged="CompareRows_SizeChanged"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="IC_CompareRows" Margin="0,0,0,8"
                                      ItemsSource="{Binding DurabilityImageGroups}">
                            <ItemsControl.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="比較ビューワーで選択画像をまとめて開く" Click="CompareSelectedImages_MenuClick"/>
                                    <MenuItem Header="比較対象へ追加" Click="AddCompareTarget_MenuClick" />
                                    <MenuItem Header="画像をダウンロードする" Click="DownloadImages_MenuClick" />
                                </ContextMenu>
                            </ItemsControl.ContextMenu>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}" Margin="8,8,8,0" Padding="10,8,10,4">
                                        <StackPanel>
                                            <!-- 行の見出し -->
                                            <DockPanel Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}"
                                                        Tag="{Binding DurabilityId}" Click="RemoveCompareDurability_Click" ToolTip="比較から外す"
                                                        Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                                                <Button DockPanel.Dock="Right" Content="＋ 比較に追加" Padding="10,2" Margin="0,0,4,0"
                                                        Tag="{Binding DurabilityId}" Click="PinBrowsingDurability_Click"
                                                        ToolTip="閲覧中の耐久を比較対象（A～D）に追加します"
                                                        Visibility="{Binding IsBrowsingOnly, Converter={StaticResource BoolToVis}}"/>
                                                <Border Style="{StaticResource SlotBadge}" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding SlotName}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding DurabilityId}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Border Style="{StaticResource EnvBadge}" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Env}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Model}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" Margin="8,1,0,0"/>
                                                <TextBlock Text="{Binding Purpose}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="12,1,0,0" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>

                                            <ListBox x:Name="PART_RowList"
                                                     ItemsSource="{Binding Cells}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     SelectionMode="Extended"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                     ScrollViewer.CanContentScroll="True"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                     PreviewMouseWheel="CompareRow_PreviewMouseWheel"
                                                     ScrollViewer.ScrollChanged="CompareRow_ScrollChanged">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="LB_Icons_PreviewMouseRightButtonDown"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>

                                                <ListBox.ItemTemplate>
                                                    <!-- DataContext は CompareCell。画像部分は Icon（IconItem）にバインドする -->
                                                    <DataTemplate>
                                                        <Grid Width="{DynamicResource IconSize}" Margin="2" ToolTip="{Binding ToolTipText}">
                                                            <StackPanel Orientation="Vertical" DataContext="{Binding Icon}">
                                                                <Image Source="{Binding ImagePath}" Stretch="Uniform"
                                                                       Height="{DynamicResource IconSize}" Width="{DynamicResource IconSize}"
                                                                       ToolTipService.InitialShowDelay="600" ToolTipService.ShowDuration="60000"
                                                                       MouseLeftButtonUp="Image_MouseLeftButtonUp">
                                                                    <Image.ToolTip>
                                                                        <ToolTip Background="White" BorderBrush="{StaticResource BorderBrushLight}" Padding="6">
                                                                            <StackPanel>
                                                                                <Image Source="{Binding ImagePath}" Width="150" Height="150" Stretch="Uniform"/>
                                                                                <TextBlock Text="{Binding ImageName}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                                                <TextBlock Text="{Binding Item1}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                <TextBlock Text="{Binding Item2}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                <TextBlock Text="{Binding Item3}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                            </StackPanel>
                                                                        </ToolTip>
                                                                    </Image.ToolTip>
                                                                </Image>
                                                                <TextBlock Text="{Binding Item1}" HorizontalAlignment="Center" Margin="0,3,0,0"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding Item2}" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding Item3}" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <!-- 該当なし -->
                                                            <Border Height="{DynamicResource IconSize}" VerticalAlignment="Top" CornerRadius="6"
                                                                    Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1"
                                                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="該当なし" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <!-- 近似表示のバッジ -->
                                                            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,4,4,0"
                                                                    Padding="6,1" CornerRadius="8" Background="#E6F59E0B"
                                                                    Visibility="{Binding IsApproximate, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding ApproxText}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- 通常表示：画像一覧 -->
                <ListBox x:Name="LB_NormalIcons" Grid.Row="1" Margin="4,4,4,0" ItemsSource="{Binding IconItems}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Extended">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="比較ビューワーで選択画像をまとめて開く" Click="CompareSelectedImages_MenuClick"/>
                            <MenuItem Header="比較対象へ追加" Click="AddCompareTarget_MenuClick"/>
                            <MenuItem Header="画像をダウンロードする" Click="DownloadImages_MenuClick"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="LB_Icons_PreviewMouseRightButtonDown"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="4" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1">
                                <StackPanel>
                                    <Image Source="{Binding ImagePath}" Stretch="Uniform"
                                           Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                                           ToolTipService.InitialShowDelay="600" ToolTipService.ShowDuration="60000"
                                           MouseLeftButtonUp="Image_MouseLeftButtonUp">
                                                                    <Image.ToolTip>
                                                                        <ToolTip Background="White" BorderBrush="{StaticResource BorderBrushLight}" Padding="6">
                                                                            <StackPanel>
                                                                                <Image Source="{Binding ImagePath}" Width="150" Height="150" Stretch="Uniform"/>
                                                                                <TextBlock Text="{Binding ImageName}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                                                <TextBlock Text="{Binding Item1}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                <TextBlock Text="{Binding Item2}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                <TextBlock Text="{Binding Item3}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                            </StackPanel>
                                                                        </ToolTip>
                                                                    </Image.ToolTip>
                                                                </Image>
                                    <TextBlock Text="{Binding Item1}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding Item2}" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Item3}" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ===== 右：トレンドグラフ＋比較用リスト ===== -->
            <Border Grid.Column="2" Background="White">
                <Grid Margin="12,10,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 見出しとグラフの設定 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <DockPanel>
                            <!-- 左端は境界線と重なるため少し内側に置く -->
                            <Button DockPanel.Dock="Left" Content="▶" Style="{StaticResource IconButton}" Margin="0,0,6,0"
                                    Click="ChangeRightPane_Click" ToolTip="グラフ・比較リストを閉じる"/>
                            <TextBlock Text="トレンド" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse Width="8" Height="8" Fill="Blue" Margin="0,0,4,0"/>
                                <TextBlock Text="測定値" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="CB_Measurement" SelectionChanged="CB_Measurement_SelectionChanged"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Rectangle Width="8" Height="8" Fill="DarkRed" Margin="0,0,4,0"/>
                                <TextBlock Text="特徴量" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="4" x:Name="CB_Feature" SelectionChanged="CB_Feature_SelectionChanged"/>
                        </Grid>
                        <TextBlock x:Name="TB_TrendTarget" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TB_SelectedImage" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- 耐久ごとのグラフ（横軸・縦軸の範囲は全グラフ共通） -->
                    <ScrollViewer Grid.Row="1" x:Name="SV_TrendGraphs" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" SizeChanged="TrendGraphs_SizeChanged">
                        <ItemsControl x:Name="IC_TrendGraphs">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="8" Padding="2,0,2,2">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6,8,0">
                                                <Border Style="{StaticResource SlotBadge}" Margin="0,0,8,0" Height="18" CornerRadius="9" MinWidth="18">
                                                    <TextBlock Text="{Binding SlotName}" Foreground="White" FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding DurabilityId}" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center"/>
                                                <Border Style="{StaticResource EnvBadge}" Height="16" Padding="4,0" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Env}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Model}" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,0,0,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Purpose}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Canvas Background="White" ClipToBounds="True" Cursor="SizeWE"
                                                    ToolTip="クリック／ドラッグでその枚数の画像へ移動"
                                                    Loaded="TrendCanvas_Loaded" SizeChanged="TrendCanvas_SizeChanged"
                                                    MouseLeftButtonDown="TrendCanvas_MouseLeftButtonDown"
                                                    MouseMove="TrendCanvas_MouseMove"
                                                    MouseLeftButtonUp="TrendCanvas_MouseLeftButtonUp"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 比較用リスト（別ウィンドウでの画像比較用） -->
                    <Expander Grid.Row="2" Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}">
                        <Expander.Header>
                            <TextBlock Text="比較用リスト" FontWeight="SemiBold"/>
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,0">
                            <Border BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="8" Padding="2">
                                <ListBox Height="200" BorderThickness="0" ItemsSource="{Binding CompareTargets}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Item1}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Item2}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Item3}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <Button Content="比較表示" Style="{StaticResource PrimaryButton}" Height="34" Margin="0,8,0,0" Click="ShowCompareTargetWindow_Click"/>
                            <Button Content="比較リストをクリア" Height="30" Margin="0,6,0,0" Click="ClearCompareTargets_Click"/>
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
